{
  "name": "@erp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.js",
    "dev:watch": "node --watch --watch-path=./src --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "fees:seed": "node --env-file-if-exists=.env src/scripts/seedFeeStructure.js",
    "students:demo": "node --env-file-if-exists=.env src/scripts/seedDemoStudents.js",
    "money:demo": "node --env-file-if-exists=.env src/scripts/seedDemoMoney.js",
    "users:seed": "node --env-file-if-exists=.env src/scripts/seedUsers.js",
    "loadtest": "node src/scripts/loadTest.js",
    "data:reset": "node --env-file-if-exists=.env src/scripts/resetData.js"
  },
  "dependencies": {
    "@erp/shared": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "read-excel-file": "^9.3.12",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
