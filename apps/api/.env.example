# Copy this file to apps/api/.env and fill the values. NEVER commit real values; NEVER paste secrets in chat.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Atlas clusters are replica sets, so transactions work.
MONGODB_URI=
MONGODB_DB_NAME=school_erp
DEFAULT_TENANT_ID=tvsm
# Synthetic seed data: development only. The API refuses to start with true in production.
ALLOW_SEED=false

# Firebase Admin (Firebase console > Project settings > Service accounts > Generate new private key).
# Put the BASE64 of that JSON file here (see README for the exact command). Never commit the JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_SA_JSON_B64=

# Login accounts created by `pnpm --filter @erp/api users:seed`. Choose NEW strong passwords (10+ characters).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_PRINCIPAL_EMAIL=
SEED_PRINCIPAL_PASSWORD=
SEED_CASHIER1_EMAIL=
SEED_CASHIER1_PASSWORD=
SEED_CASHIER2_EMAIL=
SEED_CASHIER2_PASSWORD=

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API setup). Leave empty to switch WhatsApp off.
# The access token is a SECRET: use a permanent (system user) token, keep it only here, never in chat.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Names of the two APPROVED message templates (see docs: Step13 WhatsApp decisions) and their language code.
WHATSAPP_TEMPLATE_RECEIPT=fee_receipt_text
WHATSAPP_TEMPLATE_TC=tc_issued
WHATSAPP_TEMPLATE_LANG=en
