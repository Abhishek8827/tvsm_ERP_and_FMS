# Copy to apps/api/.env for local development. NEVER commit real values. NEVER paste secrets in chat.
# Production values live only in Railway/Vercel environment settings.

# ---- API (apps/api) ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
# Local replica set from docker-compose (transactions need a replica set)
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=school_erp
DEFAULT_TENANT_ID=tvsm
# Synthetic seed data: development/staging only. The API refuses to start with true in production.
ALLOW_SEED=false

# ---- Firebase (needed from Step 2) ----
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_SA_JSON_B64=
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ---- Seed users, local only (Step 2): choose your OWN values, do not reuse real passwords ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_PRINCIPAL_EMAIL=
SEED_PRINCIPAL_PASSWORD=
SEED_CASHIER_EMAIL=
SEED_CASHIER_PASSWORD=

# ---- Web (apps/web/.env.local) ----
# Leave empty in local dev: Vite proxies /api to http://localhost:4000
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
