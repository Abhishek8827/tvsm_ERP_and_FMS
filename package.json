{
  "name": "school-erp",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @erp/api --filter @erp/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "money:demo": "pnpm --filter @erp/api money:demo",
    "students:demo": "pnpm --filter @erp/api students:demo",
    "fees:seed": "pnpm --filter @erp/api fees:seed",
    "users:seed": "pnpm --filter @erp/api users:seed",
    "data:reset": "pnpm --filter @erp/api data:reset"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "pnpm": {
    "overrides": {
      "body-parser": ">=2.4.0"
    }
  }
}
