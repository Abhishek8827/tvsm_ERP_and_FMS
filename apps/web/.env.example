# Copy this file to apps/web/.env.local and fill the values (Firebase console > Project settings > Your apps > Web app).
# Leave VITE_API_BASE_URL empty locally: Vite forwards /api to http://localhost:4000
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
