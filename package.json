{
  "name": "school-erp",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @erp/api --filter @erp/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "vite@<=6.4.1": ">=6.4.2",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "vite@<=6.4.2": ">=6.4.3",
      "react-router@>=6.0.0 <7.18.0": ">=7.18.0",
      "react-router@>=6.4.0 <7.18.0": ">=7.18.0",
      "vitest@<3.2.6": ">=3.2.6",
      "vitest@>=2.1.0 <4.1.11": ">=4.1.11",
      "@vitest/mocker@>=2.1.0 <4.1.11": ">=4.1.11",
      "postcss-selector-parser@<7.1.6": ">=7.1.6",
      "tinypool@<=2.1.0": ">=2.1.1",
      "tinypool@<2.1.2": ">=2.1.2"
    }
  }
}
